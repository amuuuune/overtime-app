<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClockOut.Setup" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/clock_out_green</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/clock_out_background</item>
        <item name="android:statusBarColor">@color/clock_out_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/clock_out_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ClockOut.Transparent" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent">@color/clock_out_green</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
